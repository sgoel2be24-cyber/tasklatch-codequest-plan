# Copy to .env (git-ignored) and fill in. `npm start` loads .env if it exists.
# With nothing set, agents use the labelled local-rules stand-in (no inference, no cost).

# --- Option A: NVIDIA free hosted endpoint
# NVIDIA_API_KEY=
# TASKLATCH_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# --- Option B: Fireworks AI (PAID, billed per token). Never used unless all three lines are set.
# TASKLATCH_PROVIDER=fireworks
# FIREWORKS_API_KEY=
# TASKLATCH_MODEL=accounts/fireworks/models/<model-id-from-your-fireworks-account>
# Your rate in USD per 1M tokens, so TaskLatch can estimate spend (otherwise cost shows as unknown):
# FIREWORKS_USD_PER_1M_TOKENS=
# Optional per-task spend cap in USD; converted into the task's token ceiling (needs the rate above):
# TASKLATCH_MAX_SPEND_USD=0.05
# Reasoning models can spend the whole output limit thinking and return no answer. 'none' turns that off
# where the provider supports it (verified for nemotron-lightning-3p5-30b-a3b on Fireworks):
# TASKLATCH_REASONING_EFFORT=none
# Ask the provider to constrain extraction output to TaskLatch's finding schema (OpenAI-style json_schema).
# 'object' sends Fireworks' json_object+schema form instead; 'off' sends neither.
# TASKLATCH_JSON_MODE=schema

# --- Optional
# TASKLATCH_OPERATOR_NAME=Local operator
# TASKLATCH_MODEL_TIMEOUT_MS=30000
